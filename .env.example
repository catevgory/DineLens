DINELENS_DB_PATH=var/dinelens.sqlite3
DINELENS_SETTINGS_PATH=var/settings.json
DINELENS_LOG_DIR=var/logs
DINELENS_ADMIN_PORT=8765
DINELENS_BACKEND_URL=http://127.0.0.1:8000
DINELENS_ANALYSIS_MODE=rules
# Runtime LLM switch. Also available through GET/PUT /settings when
# DINELENS_ADMIN_TOKEN is configured.
DINELENS_LLM_ENABLED=false
# DINELENS_ADMIN_TOKEN=change-me
DINELENS_SCORE_METHOD=bayesian_time_v1
DINELENS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DINELENS_COOKIE_SECURE=false
# DINELENS_WEB_URL=https://your-project.pages.dev/
DINELENS_SHARE_DAYS=30
DINELENS_RAW_DAYS=90
DINELENS_REPORT_DAYS=365
# Local-model mode
# DINELENS_ANALYSIS_MODE=ollama
# DINELENS_OLLAMA_MODEL=qwen2.5:3b
# DINELENS_OLLAMA_URL=http://127.0.0.1:11434
# DINELENS_BROWSER_PROFILE=/absolute/path/to/browser-profile
